[Unit]
Description=Gunicorn daemon for CSVS IT TECH (VMMC ERP)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/csvsittech
EnvironmentFile=/etc/csvsittech/.env

# Ensures /run/gunicorn exists with proper permissions
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

ExecStart=/var/www/csvsittech/venv/bin/gunicorn --config /var/www/csvsittech/deploy/gunicorn/gunicorn.conf.py vmmc_erp.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID

KillMode=mixed
TimeoutStopSec=15
PrivateTmp=true

Restart=always
RestartSec=5s

# Resource Controls for t3.micro stability
MemoryMax=800M

[Install]
WantedBy=multi-user.target
