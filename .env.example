# ============================================================
# CSVS IT TECH — Environment Configuration Template
# ============================================================

# Environment Mode (False in production)
DEBUG=False

# Django Secret Key (Generate a strong 50+ character random string)
SECRET_KEY=generate-a-strong-random-secret-key-for-production

# Hostnames & Domains
ALLOWED_HOSTS=csvsittech.in,www.csvsittech.in,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://csvsittech.in,https://www.csvsittech.in

# SSL / HTTPS Configuration (True when Nginx/Certbot is active)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# PostgreSQL Database Configuration
USE_POSTGRES=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=csvsittech_db
DB_USER=csvsittech_user
DB_PASSWORD=your_secure_database_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Or configured directly via DATABASE_URL:
# DATABASE_URL=postgresql://csvsittech_user:your_secure_database_password_here@127.0.0.1:5432/csvsittech_db

